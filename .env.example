# Required server configuration
PORT=3000
FRONTEND_URL=https://your-frontend.example.com
ALLOWED_ORIGINS=https://your-frontend.example.com
OWNER_EMAIL=owner@example.com
JWT_SECRET=replace-with-a-long-random-secret

# Database: use one provider, preferably MongoDB Atlas or a managed Mongo-compatible service
MONGO_URI=mongodb+srv://username:password@cluster.example.mongodb.net/hamza_store

# Brevo API عبر HTTPS (مفضل على Render؛ لا يتأثر بحجب منافذ SMTP)
BREVO_API_KEY=
SMTP_FROM=owner@example.com

# SMTP fallback credentials (never commit real values)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password

# Optional integrations
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CALLBACK_URL=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_CALLBACK_URL=
